{
  "name": "pthhs-site-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic build and verification tooling for the PTHHS static site.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:primetime": "node scripts/build-primetime-assets.mjs",
    "check:primetime": "node scripts/build-primetime-assets.mjs --check",
    "check": "bash scripts/build-and-verify.sh",
    "check:repository": "python3 scripts/repository_audit.py"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "terser": "5.51.2"
  }
}
