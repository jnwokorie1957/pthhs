{
  "name": "pthhs-primetime-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-only services for the PTHHS /primetime management layer.",
  "main": "lib/index.js",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "npm run build && node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "9.1.0",
    "fast-xml-parser": "5.11.1",
    "firebase-admin": "14.4.0",
    "firebase-functions": "7.3.2",
    "google-auth-library": "10.9.1",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2"
  }
}
